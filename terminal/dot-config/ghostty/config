font-family = JetBrainsMono Nerd Font
font-size = 18

freetype-load-flags = light,autohint
alpha-blending = linear-corrected
adjust-cell-height = 10%
font-style = Medium

theme = light:foot-nvim-light,dark:foot-less-dark

window-padding-x = 15
window-padding-y = 12

cursor-style = block
cursor-style-blink = false

mouse-hide-while-typing = true
