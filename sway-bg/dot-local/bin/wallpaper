#!/bin/bash
# Define your settings here
FOLDER="$HOME/Pictures/wallpapers/"
#NAME="Niri cut.png"
#NAME="dark.jpg"
NAME="dark_sand.jpg"
WALLPAPER="$FOLDER$NAME"
MODE="fill"
COLOR="#1e1e2e"

# Kill any old instances to prevent resource leaks
pkill swaybg

# Execute swaybg
swaybg -i "$WALLPAPER" -m "$MODE" -c "$COLOR"

